{
  "name": "penny-money-leaks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal, AI-powered personal spending journal for Vercel and Turso.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
