# Never put these values in public/ or commit your .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# For local development you may instead use TURSO_DATABASE_URL=file:local.db
PORT=3000

# Google OAuth web application. Use your deployed HTTPS origin on Vercel.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: <APP_URL>/api/auth?action=callback
