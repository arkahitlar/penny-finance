# Never put these values in public/ or commit your .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Choose groq for the Groq free tier, or openai for the original provider.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# For local development you may instead use TURSO_DATABASE_URL=file:local.db
PORT=3000

# Google OAuth web application. Use your deployed HTTPS origin on Vercel.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: <APP_URL>/api/auth?action=callback

# Cloudflare Workers AI (alternative provider: AI_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
